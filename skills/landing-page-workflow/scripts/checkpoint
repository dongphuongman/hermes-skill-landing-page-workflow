#!/usr/bin/env python3
"""checkpoint — luoi an toan Git cho vong lap lam viec voi agent.

Lenh:
  guard              Kiem tra working tree sach. Exit 1 neu ban.
                     Chay TRUOC moi luot giao viec lon cho agent.
  status             Agent da doi nhung gi (git status + thong ke diff).
  save [nhan]        git stash push -u — sao luu ca file untracked.
  commit <thong-diep>  git add -A && git commit.
  rollback           stash -u roi git reset --hard HEAD.
  restore <file>     Khoi phuc dung mot file ve ban commit gan nhat.

Vi sao rollback luon stash truoc: `git reset --hard` xoa VINH VIEN moi thay
doi chua commit tren file tracked va KHONG dung toi file untracked. Stash -u
gom ca hai loai, nen ke ca reset nham van lay lai duoc bang `git stash pop`.

Exit codes: 0 = ok, 1 = dieu kien khong thoa (tree ban, khong phai repo git),
2 = loi noi bo hoac sai cach dung.
"""

import subprocess
import sys
import time


def git(*args, **kw):
    """Chay git, tra (rc, stdout). check=True thi nem SystemExit khi loi."""
    p = subprocess.run(["git"] + list(args), capture_output=True, text=True)
    if kw.get("check") and p.returncode != 0:
        sys.stderr.write((p.stderr or p.stdout).strip() + "\n")
        raise SystemExit(2)
    return p.returncode, (p.stdout or "")


def ensure_repo():
    rc, _ = git("rev-parse", "--git-dir")
    if rc != 0:
        print("checkpoint: thu muc nay khong phai kho Git.")
        print("  Chay truoc:  git init && git add . && git commit -m 'Chore: khoi tao'")
        raise SystemExit(1)


def dirty_entries():
    _, out = git("status", "--porcelain")
    return [l for l in out.splitlines() if l.strip()]


def has_commit():
    rc, _ = git("rev-parse", "--verify", "HEAD")
    return rc == 0


def cmd_guard():
    ensure_repo()
    if not has_commit():
        print("checkpoint: chua co commit nao — khong co moc de quay ve.")
        print("  Chay:  git add . && git commit -m 'Chore: khoi tao du an'")
        return 1
    entries = dirty_entries()
    if entries:
        print("checkpoint: working tree BAN — %d thay doi chua commit:" % len(entries))
        for e in entries[:20]:
            print("   %s" % e)
        if len(entries) > 20:
            print("   ... va %d muc khac" % (len(entries) - 20))
        print("\nCommit hoac stash truoc khi giao viec cho agent:")
        print("  python3 scripts/checkpoint commit \"...\"")
        print("  python3 scripts/checkpoint save truoc-khi-giao-viec")
        return 1
    print("checkpoint: working tree sach — an toan de giao viec cho agent.")
    return 0


def cmd_status():
    ensure_repo()
    _, out = git("status", "--short")
    print(out if out.strip() else "(khong co thay doi)")
    _, stat = git("diff", "--stat")
    if stat.strip():
        print("\nThay doi tren file tracked:")
        print(stat.rstrip())
    return 0


def cmd_save(label):
    ensure_repo()
    if not dirty_entries():
        print("checkpoint: khong co gi de luu — tree da sach.")
        return 0
    msg = label or ("checkpoint-%s" % time.strftime("%Y%m%d-%H%M%S"))
    rc, out = git("stash", "push", "-u", "-m", msg)
    if rc != 0:
        sys.stderr.write(out)
        return 2
    print("checkpoint: da luu vao stash — \"%s\"" % msg)
    print("  Lay lai:  git stash pop")
    return 0


def cmd_commit(message):
    ensure_repo()
    if not message:
        print("checkpoint: thieu thong diep commit.")
        print("  Vi du:  python3 scripts/checkpoint commit \"Feat: sua bo cuc hero\"")
        return 2
    if not dirty_entries():
        print("checkpoint: khong co thay doi nao de commit.")
        return 0
    git("add", "-A", check=True)
    rc, out = git("commit", "-m", message)
    if rc != 0:
        sys.stderr.write(out)
        return 2
    _, sha = git("rev-parse", "--short", "HEAD")
    print("checkpoint: da commit %s — %s" % (sha.strip(), message))
    return 0


def cmd_rollback():
    ensure_repo()
    if not has_commit():
        print("checkpoint: chua co commit nao de quay ve.")
        return 1
    entries = dirty_entries()
    if not entries:
        print("checkpoint: tree da sach, khong can rollback.")
        return 0

    # Stash TRUOC khi reset. reset --hard khong the hoan tac; stash thi co.
    label = "truoc-rollback-%s" % time.strftime("%Y%m%d-%H%M%S")
    rc, out = git("stash", "push", "-u", "-m", label)
    if rc != 0:
        sys.stderr.write(out)
        print("checkpoint: stash that bai — DUNG LAI, khong reset.")
        return 2
    print("checkpoint: da sao luu %d thay doi vao stash \"%s\"" % (len(entries), label))

    rc, out = git("reset", "--hard", "HEAD")
    if rc != 0:
        sys.stderr.write(out)
        return 2
    _, sha = git("rev-parse", "--short", "HEAD")
    print("checkpoint: da quay ve HEAD (%s)" % sha.strip())
    print("  Lay lai thay doi vua bo:  git stash pop")
    print("  Luu y: file untracked da duoc gom vao stash, khong bi mat.")
    return 0


def cmd_restore(path):
    ensure_repo()
    if not path:
        print("checkpoint: thieu duong dan file.")
        return 2
    rc, out = git("restore", path)
    if rc != 0:
        sys.stderr.write(out)
        return 2
    print("checkpoint: da khoi phuc %s ve ban commit gan nhat." % path)
    return 0


USAGE = __doc__


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(USAGE)
        return 0
    cmd, rest = argv[0], argv[1:]
    arg = rest[0] if rest else ""
    table = {
        "guard": lambda: cmd_guard(),
        "status": lambda: cmd_status(),
        "save": lambda: cmd_save(arg),
        "commit": lambda: cmd_commit(" ".join(rest)),
        "rollback": lambda: cmd_rollback(),
        "restore": lambda: cmd_restore(arg),
    }
    if cmd not in table:
        print("checkpoint: lenh khong hop le: %s\n" % cmd)
        print(USAGE)
        return 2
    return table[cmd]()


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        sys.exit(2)
